+bool RekordboxUsbSession::loadExternal(const QString& root) {
+    const auto fail = [&](UsbSessionState state, UsbSessionError code, const QString& error) {
+        const std::lock_guard<std::mutex> lock(m_mutex);
+        if (m_state != UsbSessionState::Invalidated) {
+            m_state = state;
+            m_errorCode = code;
+            m_error = error;
+        }
+        return false;
+    };
+    if (root.isEmpty() || !QFileInfo::exists(root) || m_externalSource.files.isEmpty()) {
+        return fail(UsbSessionState::Missing, UsbSessionError::MissingDevice,
+                QStringLiteral("Library is missing"));
+    }
+    for (const auto& file : m_externalSource.files) {
+        if (!QFileInfo(file).isReadable()) {
+            return fail(UsbSessionState::Unreadable, UsbSessionError::UnreadableDevice,
+                    QStringLiteral("Library file is unreadable: %1").arg(file));
+        }
+    }
+    // Every source is read-only before any track can be projected from it.
+    setReadOnlySourceRoot(root, true);
+    if (!m_externalSource.volumeRoot.isEmpty()) {
+        setReadOnlySourceRoot(m_externalSource.volumeRoot, true);
+    }
+    const auto fingerprint = externalCatalogFingerprint(m_externalSource.files);
+    ExternalCatalogOptions options;
+    options.volumeRoot = m_externalSource.volumeRoot.isEmpty()
+            ? QString()
+            : QFileInfo(m_externalSource.volumeRoot).canonicalFilePath();
+    options.includeFolderCategory = m_externalSource.includeFolderCategory;
+    QString error;
+    auto catalog = buildExternalCatalog(m_externalSource.files, options, &error);
+    if (!catalog) {
+        return fail(UsbSessionState::Error, UsbSessionError::CorruptExport, error);
+    }
+    if (!error.isEmpty()) {
+        qWarning() << "External library loaded with warnings:" << error;
+    }
+    const std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_state == UsbSessionState::Invalidated) {
+        catalog->invalidate();
+        return false;
+    }
+    DeviceSnapshot snapshot;
+    snapshot.root = QFileInfo(root).canonicalFilePath();
+    snapshot.state = DeviceState::Readable;
+    snapshot.fingerprint = fingerprint;
+    snapshot.externalKind = m_externalSource.kind;
+    snapshot.externalFiles = m_externalSource.files;
+    m_snapshot = snapshot;
+    m_catalog = std::move(catalog);
+    m_state = UsbSessionState::Ready;
+    return true;
+}
