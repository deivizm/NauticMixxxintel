diff --git a/src/test/rx3folderusb_test.cpp b/src/test/rx3folderusb_test.cpp
new file mode 100644
index 0000000..0883088
--- /dev/null
+++ b/src/test/rx3folderusb_test.cpp
@@ -0,0 +1,91 @@
+#include <gtest/gtest.h>
+
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QTemporaryDir>
+
+#include "library/rekordbox/rekordboxdevice.h"
+#include "widget/rx3mysettingswriter.h"
+#include "widget/rx3sourceappearance.h"
+
+namespace {
+using namespace mixxx::rekordbox;
+
+void touch(const QString& path) {
+    ASSERT_TRUE(QDir().mkpath(QFileInfo(path).absolutePath()));
+    QFile file(path);
+    ASSERT_TRUE(file.open(QIODevice::WriteOnly));
+    ASSERT_EQ(file.write("fixture"), 7);
+}
+
+bool isMp3(const QString& name) {
+    return name.endsWith(QStringLiteral(".mp3"), Qt::CaseInsensitive);
+}
+} // namespace
+
+TEST(Rx3FolderUsbTest, FolderUsbIsReadOnlyForEveryWriter) {
+    QTemporaryDir usb;
+    ASSERT_TRUE(usb.isValid());
+    const QString root = QFileInfo(usb.path()).canonicalFilePath();
+    touch(QDir(root).filePath("Music/track.mp3"));
+    ASSERT_TRUE(QDir(root).mkpath("PIONEER"));
+
+    const auto snapshot = inspectFolderDevice(root);
+    ASSERT_EQ(DeviceState::Readable, snapshot.state) << snapshot.error.toStdString();
+    EXPECT_TRUE(snapshot.folderOnly);
+    EXPECT_EQ(root, snapshot.root);
+    EXPECT_FALSE(snapshot.mountIdentity.isEmpty());
+
+    const QString track = QDir(root).filePath("Music/track.mp3");
+    EXPECT_TRUE(isFolderOnlyPath(track));
+    EXPECT_TRUE(isReadOnlyPath(track));
+    EXPECT_TRUE(isReadOnlyPath(QDir(root).filePath("Music/new-file.wav")));
+
+    EXPECT_EQ(QStringLiteral("This USB is read-only in NauticMixxx."),
+            rx3::saveSourceColor(root, 1));
+    EXPECT_FALSE(QFileInfo::exists(rx3::sourceAppearancePath(root)));
+    EXPECT_EQ(QStringLiteral("This USB is read-only in NauticMixxx."),
+            rx3::saveUsbMySettings(root, {{QStringLiteral("quantize"), 1.0}}));
+    EXPECT_EQ(QStringList{"PIONEER"},
+            QDir(root).entryList(QDir::Dirs | QDir::NoDotAndDotDot, QDir::Name)
+                    .filter(QStringLiteral("PIONEER")));
+    EXPECT_TRUE(QDir(QDir(root).filePath("PIONEER"))
+                        .entryList(QDir::AllEntries | QDir::NoDotAndDotDot)
+                        .isEmpty());
+}
+
+TEST(Rx3FolderUsbTest, RekordboxExportReplacesFolderOnlyClassification) {
+    QTemporaryDir usb;
+    ASSERT_TRUE(usb.isValid());
+    const QString root = QFileInfo(usb.path()).canonicalFilePath();
+    const auto folder = inspectFolderDevice(root);
+    ASSERT_EQ(DeviceState::Readable, folder.state);
+    ASSERT_TRUE(isFolderOnlyPath(root));
+
+    touch(QDir(root).filePath("PIONEER/rekordbox/export.pdb"));
+    const auto exported = inspectDevice(root);
+    EXPECT_FALSE(exported.folderOnly);
+    EXPECT_FALSE(isFolderOnlyPath(root));
+    // Still protected from Mixxx writes as a rekordbox root.
+    EXPECT_TRUE(isReadOnlyPath(QDir(root).filePath("track.mp3")));
+    // Re-discovery treats the two kinds as different devices.
+    EXPECT_FALSE(folder.matches(exported));
+    EXPECT_TRUE(folder.matches(inspectFolderDevice(root)));
+}
+
+TEST(Rx3FolderUsbTest, AudioProbeIsBoundedAndIgnoresSystemFolders) {
+    QTemporaryDir usb;
+    ASSERT_TRUE(usb.isValid());
+    const QString root = usb.path();
+    touch(QDir(root).filePath(".Spotlight-V100/hidden.mp3"));
+    touch(QDir(root).filePath("System Volume Information/hidden.mp3"));
+    touch(QDir(root).filePath("Documents/readme.txt"));
+    EXPECT_FALSE(folderContainsSupportedAudio(root, isMp3));
+
+    touch(QDir(root).filePath("A/B/C/deep.mp3"));
+    EXPECT_FALSE(folderContainsSupportedAudio(root, isMp3, 2));
+    EXPECT_TRUE(folderContainsSupportedAudio(root, isMp3, 3));
+    EXPECT_FALSE(folderContainsSupportedAudio(root, isMp3, 4, 3));
+    EXPECT_FALSE(folderContainsSupportedAudio(QDir(root).filePath("missing"), isMp3));
+}
