+TrackPointer RekordboxTrackAdapter::createExternalTemporaryTrack(
+        const RuntimeTrack& runtimeTrack,
+        QString* error) {
+    if (error) {
+        error->clear();
+    }
+    const auto fail = [error](const QString& message) -> TrackPointer {
+        if (error) {
+            *error = message;
+        }
+        return {};
+    };
+    if (runtimeTrack.rekordboxId == 0 || runtimeTrack.resolvedAudioPath.isEmpty()) {
+        return fail(QStringLiteral("The audio file of this library track was not found"));
+    }
+    mixxx::FileInfo fileInfo(runtimeTrack.resolvedAudioPath);
+    if (!fileInfo.checkFileExists() || !QFileInfo(runtimeTrack.resolvedAudioPath).isFile()) {
+        return fail(QStringLiteral("Library track audio file is missing"));
+    }
+    // Library music usually lives outside removable volumes: reuse any folder
+    // permission the user granted (sandboxed macOS builds).
+    auto token = Sandbox::openSecurityToken(&fileInfo, true);
+    auto track = Track::newTemporary(
+            mixxx::FileAccess(fileInfo, std::move(token)),
+            mixxx::TrackUsePolicy::usbFolderPolicy(),
+            mixxx::SourceBinding::standardLibrary());
+    if (!track) {
+        return fail(QStringLiteral("Cannot create read-only temporary track"));
+    }
+    const auto provider = runtimeTrack.rawMetadata.value(QStringLiteral("provider")).toString();
+    // rekordbox XML positions share rekordbox's MP3 timeline (see the decoder
+    // offset applied to rekordbox USB tracks); Traktor positions do not.
+    track->setProperty("rekordboxTimingSemantics", provider == QStringLiteral("rekordbox_xml"));
+    track->setProperty("externalLibraryProvider", provider);
+    track->setTitle(runtimeTrack.title);
+    track->setArtist(runtimeTrack.artist);
+    track->setAlbum(runtimeTrack.album);
+    track->updateGenre(runtimeTrack.genre);
+    track->setComment(runtimeTrack.comment);
+    track->setComposer(runtimeTrack.composer);
+    const auto year = runtimeTrack.rawMetadata.value(QStringLiteral("year")).toString();
+    if (!year.isEmpty()) {
+        track->setYear(year);
+    }
+    if (runtimeTrack.durationSeconds && *runtimeTrack.durationSeconds > 0) {
+        track->setDuration(static_cast<double>(*runtimeTrack.durationSeconds));
+    }
+    if (runtimeTrack.rating) {
+        track->setRating(static_cast<int>(*runtimeTrack.rating));
+    }
+    if (!runtimeTrack.key.isEmpty()) {
+        track->setKeyText(runtimeTrack.key, mixxx::track::io::key::FILE_METADATA);
+    }
+    const double gridBpm = runtimeTrack.rawMetadata.value(QStringLiteral("grid_bpm")).toDouble();
+    if (gridBpm > 0 && runtimeTrack.rawMetadata.contains(QStringLiteral("grid_ms"))) {
+        track->tryImportBeats(std::make_shared<ConstGridBeatsImporter>(gridBpm,
+                                      runtimeTrack.rawMetadata.value(QStringLiteral("grid_ms"))
+                                              .toDouble()),
+                false);
+    } else if (runtimeTrack.beats.size() >= 2) {
+        track->tryImportBeats(
+                std::make_shared<RekordboxBeatsImporter>(runtimeTrack.beats),
+                false);
+    }
+    QList<mixxx::CueInfo> cueInfos = cueInfosFor(runtimeTrack);
+    if (!cueInfos.isEmpty()) {
+        track->importCueInfos(
+                std::make_unique<RekordboxCueInfoImporter>(std::move(cueInfos)));
+    }
+    track->markClean();
+    return track;
+}
+
 } // namespace mixxx::rekordbox
