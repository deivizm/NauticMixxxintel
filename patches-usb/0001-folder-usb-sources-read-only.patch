+bool folderContainsSupportedAudio(const QString& root,
+        const std::function<bool(const QString&)>& isSupportedFileName,
+        int maxDepth,
+        int maxEntries) {
+    const QString canonicalRoot = QFileInfo(root).canonicalFilePath();
+    if (canonicalRoot.isEmpty() || !isSupportedFileName) {
+        return false;
+    }
+    QList<QPair<QString, int>> pending{{canonicalRoot, 0}};
+    int visited = 0;
+    while (!pending.isEmpty()) {
+        const auto [directory, depth] = pending.takeFirst();
+        QDirIterator entries(directory,
+                QDir::Dirs | QDir::Files | QDir::NoDotAndDotDot | QDir::Readable);
+        while (entries.hasNext()) {
+            entries.next();
+            if (++visited > maxEntries) {
+                return false;
+            }
+            const QFileInfo entry = entries.fileInfo();
+            const QString name = entry.fileName();
+            // System folders and links never decide that a volume holds music.
+            if (entry.isSymLink() || name.startsWith(QChar('.')) ||
+                    name.compare(QStringLiteral("System Volume Information"),
+                            Qt::CaseInsensitive) == 0 ||
+                    name.compare(QStringLiteral("$RECYCLE.BIN"), Qt::CaseInsensitive) == 0) {
+                continue;
+            }
+            if (entry.isDir()) {
+                if (depth + 1 <= maxDepth) {
+                    pending.append({entry.absoluteFilePath(), depth + 1});
+                }
+            } else if (isSupportedFileName(name)) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
