+// hidden folders are skipped, links are never followed).
+QStringList findExternalCatalogFiles(const QString& root,
+        int maxDepth = 2,
+        int maxEntries = 3000,
+        int maxFiles = 32);
+
+// Newest "<Documents>/Native Instruments/Traktor x.y.z/collection.nml".
+QString findLocalTraktorCollection(const QString& documentsPath);
+
+struct ExternalCatalogOptions {
+    // Catalogs found on a USB resolve exported locations inside this volume
+    // first (Traktor "Export Playlist", rekordbox XML copied with the music).
+    QString volumeRoot;
+    // USB catalogs also offer FOLDER browsing of the volume.
+    bool includeFolderCategory{false};
+    // Test hook; defaults to QFileInfo::exists.
+    std::function<bool(const QString&)> fileExists;
+};
+
+// Builds and seals a catalog from one or more library files. Tracks keep
+// their absolute audio path in resolvedAudioPath (empty when not found).
+// rawMetadata carries "provider" ("traktor" / "rekordbox_xml") and, for a
+// constant tempo, "grid_bpm" / "grid_ms" (first beat, milliseconds).
+std::shared_ptr<RuntimeCatalog> buildExternalCatalog(const QStringList& files,
+        const ExternalCatalogOptions& options,
+        QString* error = nullptr);
+
+// Identity of the inputs (path, size, modification time). A change makes
+// discovery rebuild the catalog.
+QByteArray externalCatalogFingerprint(const QStringList& files);
+
+// Traktor MUSICAL_KEY value (0..23) to key text, or empty.
+QString traktorMusicalKeyText(int value);
+
+} // namespace mixxx::rekordbox
