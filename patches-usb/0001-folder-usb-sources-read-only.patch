+namespace mixxx::rekordbox {
+namespace {
+
+// Resource bounds, not format restrictions.
+constexpr qint64 kMaxCatalogBytes = 256LL * 1024 * 1024;
+constexpr int kMaxTracks = 250000;
+constexpr int kMaxPlaylistDepth = 32;
+constexpr int kMaxPlaylistNodes = 50000;
+constexpr int kMaxGeneratedBeats = 20000;
+
+struct ParsedTrack {
+    RuntimeTrack track;
+    QStringList lookupKeys; // file-local identities used by playlists
+};
+
+struct ParsedNode {
+    QString name;
+    bool isFolder{false};
+    QList<ParsedNode> children;
+    QStringList entryKeys;
+};
+
+struct ParsedFile {
+    QList<ParsedTrack> tracks;
+    QList<ParsedNode> roots;
+    QString error;
+};
+
+bool fileExists(const ExternalCatalogOptions& options, const QString& path) {
+    if (path.isEmpty()) {
+        return false;
+    }
+    return options.fileExists ? options.fileExists(path) : QFileInfo::exists(path);
+}
+
+QString firstExisting(const QStringList& candidates, const ExternalCatalogOptions& options) {
+    for (const auto& candidate : candidates) {
+        if (!candidate.isEmpty() && fileExists(options, candidate)) {
+            return QDir::cleanPath(candidate);
+        }
+    }
+    return {};
+}
+
+quint32 ratingFrom255(int value) {
+    return static_cast<quint32>(qBound(0, (value + 25) / 51, 5));
+}
+
+bool isSkippedSystemName(const QString& name) {
+    return name.startsWith(QChar('.')) ||
+            name.compare(QStringLiteral("System Volume Information"), Qt::CaseInsensitive) == 0 ||
+            name.compare(QStringLiteral("$RECYCLE.BIN"), Qt::CaseInsensitive) == 0;
+}
+
+// --- Traktor -----------------------------------------------------------------
+
+QString traktorRelativePath(const QString& dir, const QString& file) {
+    QString path = dir;
+    path.replace(QStringLiteral("/:"), QStringLiteral("/"));
+    if (!path.startsWith(QChar('/'))) {
+        path.prepend(QChar('/'));
+    }
+    if (!path.endsWith(QChar('/'))) {
+        path.append(QChar('/'));
+    }
+    return path + file;
+}
+
+QString resolveTraktorLocation(const QString& volume,
+        const QString& dir,
+        const QString& file,
+        const ExternalCatalogOptions& options) {
+    if (file.isEmpty()) {
+        return {};
+    }
+    const QString relative = traktorRelativePath(dir, file);
+    QStringList candidates;
+    if (!options.volumeRoot.isEmpty()) {
+        candidates.append(options.volumeRoot + relative);
+    }
+#if defined(Q_OS_WIN)
+    if (!volume.isEmpty()) {
+        candidates.append(volume + relative);
+    }
+#else
+    if (!volume.isEmpty()) {
+        candidates.append(QStringLiteral("/Volumes/") + volume + relative);
+    }
+    candidates.append(relative);
+#endif
+    return firstExisting(candidates, options);
+}
+
+void appendTraktorCue(RuntimeTrack* track,
+        QList<RuntimeCue>* loadCues,
+        const QXmlStreamAttributes& attributes,
+        std::optional<double>* gridMs) {
+    bool ok = false;
+    const int type = attributes.value(QStringLiteral("TYPE")).toInt(&ok);
+    if (!ok) {
+        return;
+    }
+    const double start = attributes.value(QStringLiteral("START")).toDouble(&ok);
+    if (!ok || !std::isfinite(start)) {
+        return;
+    }
+    const double length = attributes.value(QStringLiteral("LEN")).toDouble();
+    const int hotcue = attributes.value(QStringLiteral("HOTCUE")).toInt(&ok);
+    const int slot = ok && hotcue >= 0 && hotcue < 8 ? hotcue + 1 : -1;
+    QString name = attributes.value(QStringLiteral("NAME")).toString();
+    if (name == QStringLiteral("n.n.")) {
+        name.clear();
+    }
+    if (type == 4) { // Grid marker: beatgrid anchor, never a cue.
+        if (!*gridMs) {
+            *gridMs = start;
+        }
+        return;
+    }
+    RuntimeCue cue;
+    cue.label = name;
+    cue.startMs = std::max(0.0, start);
+    if (type == 5) { // Loop
+        if (!(length > 0) || !std::isfinite(length)) {
+            return;
+        }
+        cue.endMs = *cue.startMs + length;
+        cue.kind = slot > 0 ? RuntimeCue::Kind::HotLoop : RuntimeCue::Kind::MemoryLoop;
+    } else { // Cue, fade in/out, load
+        cue.kind = slot > 0 ? RuntimeCue::Kind::HotCue : RuntimeCue::Kind::MemoryCue;
+    }
+    cue.hotcueIndex = slot;
+    if (type == 3) {
+        // The load marker becomes the main cue (first memory cue).
+        RuntimeCue load = cue;
+        load.kind = RuntimeCue::Kind::MemoryCue;
+        load.hotcueIndex = -1;
+        load.endMs.reset();
+        loadCues->append(load);
+        if (slot <= 0) {
+            return;
+        }
+    }
+    track->cues.append(cue);
+}
+
+ParsedTrack parseTraktorEntry(QXmlStreamReader& xml, const ExternalCatalogOptions& options) {
+    ParsedTrack parsed;
+    auto& track = parsed.track;
+    const auto entry = xml.attributes();
+    track.title = entry.value(QStringLiteral("TITLE")).toString();
+    track.artist = entry.value(QStringLiteral("ARTIST")).toString();
+    QString volume, dir, file;
+    std::optional<double> gridMs;
+    std::optional<int> musicalKey;
+    QList<RuntimeCue> loadCues;
+    while (!xml.atEnd()) {
+        const auto token = xml.readNext();
+        if (token == QXmlStreamReader::EndElement &&
+                xml.name() == QStringLiteral("ENTRY")) {
+            break;
+        }
+        if (token != QXmlStreamReader::StartElement) {
+            continue;
+        }
+        const auto name = xml.name();
+        const auto attributes = xml.attributes();
+        if (name == QStringLiteral("LOCATION")) {
+            volume = attributes.value(QStringLiteral("VOLUME")).toString();
+            dir = attributes.value(QStringLiteral("DIR")).toString();
+            file = attributes.value(QStringLiteral("FILE")).toString();
+        } else if (name == QStringLiteral("ALBUM")) {
+            track.album = attributes.value(QStringLiteral("TITLE")).toString();
+        } else if (name == QStringLiteral("INFO")) {
+            track.genre = attributes.value(QStringLiteral("GENRE")).toString();
+            track.comment = attributes.value(QStringLiteral("COMMENT")).toString();
+            track.key = attributes.value(QStringLiteral("KEY")).toString();
+            bool ok = false;
+            const int playtime = attributes.value(QStringLiteral("PLAYTIME")).toInt(&ok);
+            if (ok && playtime > 0) {
+                track.durationSeconds = static_cast<quint32>(playtime);
+            }
+            const int ranking = attributes.value(QStringLiteral("RANKING")).toInt(&ok);
+            if (ok) {
+                track.rating = ratingFrom255(ranking);
+            }
+            for (const auto& field : {QStringLiteral("LABEL"), QStringLiteral("REMIXER")}) {
+                const auto value = attributes.value(field).toString();
+                if (!value.isEmpty()) {
+                    track.rawMetadata.insert(field.toLower(), value);
+                }
+            }
+            const auto released = attributes.value(QStringLiteral("RELEASE_DATE")).toString();
+            if (released.size() >= 4 && released.left(4).toInt() > 0) {
+                track.rawMetadata.insert(QStringLiteral("year"), released.left(4));
+            }
+            const auto imported = attributes.value(QStringLiteral("IMPORT_DATE")).toString();
+            if (!imported.isEmpty()) {
+                track.rawMetadata.insert(QStringLiteral("date_added"),
+                        QString(imported).replace(QChar('/'), QChar('-')));
+            }
+        } else if (name == QStringLiteral("TEMPO")) {
+            bool ok = false;
+            const double bpm = attributes.value(QStringLiteral("BPM")).toDouble(&ok);
+            if (ok && bpm > 0 && bpm < 1000) {
+                track.bpm = bpm;
+            }
+        } else if (name == QStringLiteral("MUSICAL_KEY")) {
+            bool ok = false;
+            const int value = attributes.value(QStringLiteral("VALUE")).toInt(&ok);
+            if (ok) {
+                musicalKey = value;
+            }
+        } else if (name == QStringLiteral("CUE_V2")) {
+            appendTraktorCue(&track, &loadCues, attributes, &gridMs);
+        }
+    }
+    if (track.key.isEmpty() && musicalKey) {
+        track.key = traktorMusicalKeyText(*musicalKey);
+    }
+    // Main cue first, then the remaining cues in file order.
+    track.cues = loadCues + track.cues;
+    if (track.bpm && gridMs) {
+        track.rawMetadata.insert(QStringLiteral("grid_bpm"), *track.bpm);
+        track.rawMetadata.insert(QStringLiteral("grid_ms"), *gridMs);
+    }
+    track.rawMetadata.insert(QStringLiteral("provider"), QStringLiteral("traktor"));
+    track.resolvedAudioPath = resolveTraktorLocation(volume, dir, file, options);
+    if (track.title.isEmpty()) {
+        track.title = QFileInfo(file).completeBaseName();
+    }
+    parsed.lookupKeys.append(volume + dir + file);
+    return parsed;
+}
+
+ParsedNode parseTraktorNode(QXmlStreamReader& xml, int depth, int* nodeCount, bool* valid) {
+    ParsedNode node;
+    const auto type = xml.attributes().value(QStringLiteral("TYPE")).toString();
+    node.name = xml.attributes().value(QStringLiteral("NAME")).toString();
+    node.isFolder = type == QStringLiteral("FOLDER");
+    *valid = node.isFolder || type == QStringLiteral("PLAYLIST");
+    if (++*nodeCount > kMaxPlaylistNodes || depth > kMaxPlaylistDepth) {
+        *valid = false;
+        xml.skipCurrentElement();
+        return node;
+    }
+    while (!xml.atEnd()) {
+        const auto token = xml.readNext();
+        if (token == QXmlStreamReader::EndElement && xml.name() == QStringLiteral("NODE")) {
+            break;
+        }
+        if (token != QXmlStreamReader::StartElement) {
+            continue;
+        }
+        if (xml.name() == QStringLiteral("NODE")) {
+            bool childValid = false;
+            auto child = parseTraktorNode(xml, depth + 1, nodeCount, &childValid);
+            if (childValid && node.isFolder) {
+                node.children.append(std::move(child));
+            }
+        } else if (xml.name() == QStringLiteral("PRIMARYKEY") &&
+                xml.attributes().value(QStringLiteral("TYPE")) == QStringLiteral("TRACK")) {
+            node.entryKeys.append(xml.attributes().value(QStringLiteral("KEY")).toString());
+        }
+    }
+    return node;
+}
+
+ParsedFile parseTraktor(QXmlStreamReader& xml, const ExternalCatalogOptions& options) {
+    ParsedFile result;
+    bool inCollection = false;
+    int nodeCount = 0;
+    while (!xml.atEnd()) {
+        const auto token = xml.readNext();
+        if (token == QXmlStreamReader::EndElement && xml.name() == QStringLiteral("COLLECTION")) {
+            inCollection = false;
+            continue;
+        }
+        if (token != QXmlStreamReader::StartElement) {
+            continue;
+        }
+        if (xml.name() == QStringLiteral("COLLECTION")) {
+            inCollection = true;
+        } else if (inCollection && xml.name() == QStringLiteral("ENTRY")) {
+            if (result.tracks.size() >= kMaxTracks) {
+                result.error = QStringLiteral("Too many tracks");
+                return result;
+            }
+            result.tracks.append(parseTraktorEntry(xml, options));
+        } else if (xml.name() == QStringLiteral("PLAYLISTS")) {
+            while (!xml.atEnd()) {
+                const auto inner = xml.readNext();
+                if (inner == QXmlStreamReader::EndElement &&
+                        xml.name() == QStringLiteral("PLAYLISTS")) {
+                    break;
+                }
+                if (inner == QXmlStreamReader::StartElement && xml.name() == QStringLiteral("NODE")) {
+                    bool valid = false;
+                    auto root = parseTraktorNode(xml, 0, &nodeCount, &valid);
+                    if (!valid) {
+                        continue;
+                    }
+                    // "$ROOT" is Traktor's invisible top folder.
+                    if (root.isFolder && root.name == QStringLiteral("$ROOT")) {
+                        result.roots.append(root.children);
+                    } else {
+                        result.roots.append(std::move(root));
+                    }
+                }
+            }
+        }
+    }
+    return result;
+}
+
+// --- rekordbox XML -------------------------------------------------------------
+
+QString localPathFromRekordboxLocation(const QString& location) {
+    QString path = location;
+    for (const auto& prefix : {QStringLiteral("file://localhost"), QStringLiteral("file://")}) {
+        if (path.startsWith(prefix, Qt::CaseInsensitive)) {
+            path = path.mid(prefix.size());
+            break;
+        }
+    }
+    path = QUrl::fromPercentEncoding(path.toUtf8());
+    // "/C:/Music/x.mp3" from a Windows export.
+    if (path.size() > 3 && path.at(0) == QChar('/') && path.at(2) == QChar(':')) {
+        path = path.mid(1);
+    }
+    return path;
+}
+
+QString resolveRekordboxLocation(const QString& location, const ExternalCatalogOptions& options) {
+    const QString path = localPathFromRekordboxLocation(location);
+    if (path.isEmpty()) {
+        return {};
+    }
+    QStringList candidates{path};
+    if (!options.volumeRoot.isEmpty()) {
+        // The XML may come from another computer or mount point: try the same
+        // path below this volume ("/Volumes/OLD/Music/x.mp3" → "<root>/Music/x.mp3").
+        QString relative = path;
+        if (relative.startsWith(QStringLiteral("/Volumes/"))) {
+            const int slash = relative.indexOf(QChar('/'), 9);
+            relative = slash >= 0 ? relative.mid(slash) : QString();
+        } else if (relative.size() > 2 && relative.at(1) == QChar(':')) {
+            relative = relative.mid(2);
+        }
+        if (!relative.isEmpty()) {
+            candidates.prepend(options.volumeRoot + relative);
+        }
+    }
+    return firstExisting(candidates, options);
+}
+
+ParsedTrack parseRekordboxTrack(QXmlStreamReader& xml, const ExternalCatalogOptions& options) {
+    ParsedTrack parsed;
+    auto& track = parsed.track;
+    const auto attributes = xml.attributes();
+    const auto text = [&](const char* name) {
+        return attributes.value(QLatin1String(name)).toString();
+    };
+    track.title = text("Name");
+    track.artist = text("Artist");
+    track.album = text("Album");
+    track.genre = text("Genre");
+    track.comment = text("Comments");
+    track.composer = text("Composer");
+    track.key = text("Tonality");
+    bool ok = false;
+    const int seconds = text("TotalTime").toInt(&ok);
+    if (ok && seconds > 0) {
+        track.durationSeconds = static_cast<quint32>(seconds);
+    }
+    const double averageBpm = text("AverageBpm").toDouble(&ok);
+    if (ok && averageBpm > 0 && averageBpm < 1000) {
+        track.bpm = averageBpm;
+    }
+    const int rating = text("Rating").toInt(&ok);
+    if (ok) {
+        track.rating = ratingFrom255(rating);
+    }
+    for (const auto& [attribute, field] : {qMakePair(QStringLiteral("Year"), QStringLiteral("year")),
+                 qMakePair(QStringLiteral("Label"), QStringLiteral("label")),
+                 qMakePair(QStringLiteral("Remixer"), QStringLiteral("remixer")),
+                 qMakePair(QStringLiteral("DateAdded"), QStringLiteral("date_added"))}) {
+        const auto value = attributes.value(attribute).toString();
+        if (!value.isEmpty() && value != QStringLiteral("0")) {
+            track.rawMetadata.insert(field, value);
+        }
+    }
+    const auto location = text("Location");
+    const auto trackId = text("TrackID");
+    struct Tempo {
+        double startMs;
+        double bpm;
+    };
+    QList<Tempo> tempos;
+    QList<RuntimeCue> memoryCues;
+    while (!xml.atEnd()) {
+        const auto token = xml.readNext();
+        if (token == QXmlStreamReader::EndElement && xml.name() == QStringLiteral("TRACK")) {
+            break;
+        }
+        if (token != QXmlStreamReader::StartElement) {
+            continue;
+        }
+        const auto child = xml.attributes();
+        if (xml.name() == QStringLiteral("TEMPO")) {
+            bool startOk = false;
+            bool bpmOk = false;
+            const double start = child.value(QStringLiteral("Inizio")).toDouble(&startOk);
+            const double bpm = child.value(QStringLiteral("Bpm")).toDouble(&bpmOk);
+            if (startOk && bpmOk && bpm > 0 && bpm < 1000 && std::isfinite(start)) {
+                tempos.append({start * 1000.0, bpm});
+            }
+        } else if (xml.name() == QStringLiteral("POSITION_MARK")) {
+            bool startOk = false;
+            const double start = child.value(QStringLiteral("Start")).toDouble(&startOk);
+            if (!startOk || !std::isfinite(start)) {
+                continue;
+            }
+            const int type = child.value(QStringLiteral("Type")).toInt();
+            const int number = child.value(QStringLiteral("Num")).toInt();
+            const int slot = number >= 0 && number < 8 ? number + 1 : -1;
+            RuntimeCue cue;
+            cue.label = child.value(QStringLiteral("Name")).toString();
+            cue.startMs = std::max(0.0, start * 1000.0);
+            if (child.hasAttribute(QStringLiteral("Red"))) {
+                const auto red = child.value(QStringLiteral("Red")).toUInt() & 0xFF;
+                const auto green = child.value(QStringLiteral("Green")).toUInt() & 0xFF;
+                const auto blue = child.value(QStringLiteral("Blue")).toUInt() & 0xFF;
+                cue.color = mixxx::RgbColor::optional((red << 16) | (green << 8) | blue);
+            }
+            if (type == 4) {
+                bool endOk = false;
+                const double end = child.value(QStringLiteral("End")).toDouble(&endOk);
+                if (!endOk || !(end > start)) {
+                    continue;
+                }
+                cue.endMs = end * 1000.0;
+                cue.kind = slot > 0 ? RuntimeCue::Kind::HotLoop : RuntimeCue::Kind::MemoryLoop;
+            } else {
+                cue.kind = slot > 0 ? RuntimeCue::Kind::HotCue : RuntimeCue::Kind::MemoryCue;
+            }
+            cue.hotcueIndex = slot;
+            if (slot > 0) {
+                track.cues.append(cue);
+            } else {
+                memoryCues.append(cue);
+            }
+        }
+    }
+    // Memory cues in time order; the earliest becomes the main cue.
+    std::stable_sort(memoryCues.begin(), memoryCues.end(), [](const auto& a, const auto& b) {
+        return *a.startMs < *b.startMs;
+    });
+    track.cues = memoryCues + track.cues;
+    std::stable_sort(tempos.begin(), tempos.end(), [](const auto& a, const auto& b) {
+        return a.startMs < b.startMs;
+    });
+    if (!tempos.isEmpty()) {
+        const bool constant = std::all_of(tempos.cbegin(), tempos.cend(), [&](const Tempo& tempo) {
+            return std::abs(tempo.bpm - tempos.first().bpm) < 0.005;
+        });
+        if (constant) {
+            track.rawMetadata.insert(QStringLiteral("grid_bpm"), tempos.first().bpm);
+            track.rawMetadata.insert(QStringLiteral("grid_ms"), tempos.first().startMs);
+        } else {
+            // Variable tempo: one beat per position, segment by segment.
+            const double endMs = track.durationSeconds
+                    ? *track.durationSeconds * 1000.0
+                    : tempos.last().startMs + 60000.0 * 64 / tempos.last().bpm;
+            for (int i = 0; i < tempos.size() && track.beats.size() < kMaxGeneratedBeats; ++i) {
+                const double segmentEnd = i + 1 < tempos.size() ? tempos[i + 1].startMs : endMs;
+                const double interval = 60000.0 / tempos[i].bpm;
+                for (double position = tempos[i].startMs;
+                        position < segmentEnd - 0.5 && track.beats.size() < kMaxGeneratedBeats;
+                        position += interval) {
+                    if (position < 0) {
+                        continue;
+                    }
+                    RuntimeBeat beat;
+                    beat.timeMs = static_cast<quint32>(std::llround(position));
+                    beat.beatInBar = static_cast<quint16>(track.beats.size() % 4 + 1);
+                    beat.tempoCentiBpm = static_cast<quint16>(
+                            qBound(1.0, std::round(tempos[i].bpm * 100.0), 65535.0));
+                    if (!track.beats.isEmpty() && beat.timeMs <= track.beats.last().timeMs) {
+                        continue;
+                    }
+                    track.beats.append(beat);
+                }
+            }
+        }
+    }
+    track.rawMetadata.insert(QStringLiteral("provider"), QStringLiteral("rekordbox_xml"));
+    track.resolvedAudioPath = resolveRekordboxLocation(location, options);
+    if (track.title.isEmpty()) {
+        track.title = QFileInfo(localPathFromRekordboxLocation(location)).completeBaseName();
+    }
+    if (!trackId.isEmpty()) {
+        parsed.lookupKeys.append(QStringLiteral("id:") + trackId);
+    }
+    if (!location.isEmpty()) {
+        parsed.lookupKeys.append(QStringLiteral("location:") + location);
+    }
+    return parsed;
+}
+
+ParsedNode parseRekordboxNode(QXmlStreamReader& xml, int depth, int* nodeCount, bool* valid) {
+    ParsedNode node;
+    const auto attributes = xml.attributes();
+    node.name = attributes.value(QStringLiteral("Name")).toString();
+    const auto type = attributes.value(QStringLiteral("Type")).toString();
+    node.isFolder = type == QStringLiteral("0");
+    *valid = node.isFolder || type == QStringLiteral("1");
+    const bool byLocation = attributes.value(QStringLiteral("KeyType")) == QStringLiteral("1");
+    if (++*nodeCount > kMaxPlaylistNodes || depth > kMaxPlaylistDepth) {
+        *valid = false;
+        xml.skipCurrentElement();
+        return node;
+    }
+    while (!xml.atEnd()) {
+        const auto token = xml.readNext();
+        if (token == QXmlStreamReader::EndElement && xml.name() == QStringLiteral("NODE")) {
+            break;
+        }
+        if (token != QXmlStreamReader::StartElement) {
+            continue;
+        }
+        if (xml.name() == QStringLiteral("NODE")) {
+            bool childValid = false;
+            auto child = parseRekordboxNode(xml, depth + 1, nodeCount, &childValid);
+            if (childValid && node.isFolder) {
+                node.children.append(std::move(child));
+            }
+        } else if (xml.name() == QStringLiteral("TRACK")) {
+            const auto key = xml.attributes().value(QStringLiteral("Key")).toString();
+            if (!key.isEmpty()) {
+                node.entryKeys.append((byLocation ? QStringLiteral("location:")
+                                                  : QStringLiteral("id:")) +
+                        key);
+            }
+        }
+    }
+    return node;
+}
+
+ParsedFile parseRekordboxXml(QXmlStreamReader& xml, const ExternalCatalogOptions& options) {
+    ParsedFile result;
+    bool inCollection = false;
+    int nodeCount = 0;
+    while (!xml.atEnd()) {
+        const auto token = xml.readNext();
+        if (token == QXmlStreamReader::EndElement && xml.name() == QStringLiteral("COLLECTION")) {
+            inCollection = false;
+            continue;
+        }
+        if (token != QXmlStreamReader::StartElement) {
+            continue;
+        }
+        if (xml.name() == QStringLiteral("COLLECTION")) {
+            inCollection = true;
+        } else if (inCollection && xml.name() == QStringLiteral("TRACK")) {
+            if (result.tracks.size() >= kMaxTracks) {
+                result.error = QStringLiteral("Too many tracks");
+                return result;
+            }
+            result.tracks.append(parseRekordboxTrack(xml, options));
+        } else if (xml.name() == QStringLiteral("PLAYLISTS")) {
+            while (!xml.atEnd()) {
+                const auto inner = xml.readNext();
+                if (inner == QXmlStreamReader::EndElement &&
+                        xml.name() == QStringLiteral("PLAYLISTS")) {
+                    break;
+                }
+                if (inner == QXmlStreamReader::StartElement && xml.name() == QStringLiteral("NODE")) {
+                    bool valid = false;
+                    auto root = parseRekordboxNode(xml, 0, &nodeCount, &valid);
+                    if (!valid) {
+                        continue;
+                    }
+                    // "ROOT" is rekordbox's invisible top folder.
+                    if (root.isFolder && root.name == QStringLiteral("ROOT")) {
+                        result.roots.append(root.children);
+                    } else {
+                        result.roots.append(std::move(root));
+                    }
+                }
+            }
+        }
+    }
+    return result;
+}
+
+ParsedFile parseFile(const QString& path,
+        ExternalCatalogKind kind,
+        const ExternalCatalogOptions& options) {
+    ParsedFile result;
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly)) {
+        result.error = file.errorString();
+        return result;
+    }
+    if (file.size() > kMaxCatalogBytes) {
+        result.error = QStringLiteral("Library file exceeds the 256 MiB read limit");
+        return result;
+    }
+    QXmlStreamReader xml(&file);
+    result = kind == ExternalCatalogKind::TraktorNml
+            ? parseTraktor(xml, options)
+            : parseRekordboxXml(xml, options);
+    if (xml.hasError() && result.error.isEmpty()) {
+        result.error = QStringLiteral("%1 (line %2)").arg(xml.errorString()).arg(xml.lineNumber());
+    }
+    return result;
+}
+
+bool convertNode(const ParsedNode& parsed,
+        const QHash<QString, quint32>& keyToId,
+        quint32* nextPlaylistId,
+        RuntimePlaylistNode* out) {
+    out->rekordboxId = (*nextPlaylistId)++;
+    out->name = parsed.name.trimmed().isEmpty() ? QStringLiteral("(untitled)") : parsed.name;
+    out->isFolder = parsed.isFolder;
+    out->sortOrder = out->rekordboxId;
+    if (parsed.isFolder) {
+        for (const auto& child : parsed.children) {
+            RuntimePlaylistNode node;
+            if (convertNode(child, keyToId, nextPlaylistId, &node)) {
+                out->children.append(std::move(node));
+            }
+        }
+    } else {
+        for (const auto& key : parsed.entryKeys) {
+            const auto id = keyToId.value(key);
+            if (id != 0) {
+                out->trackIds.append(id);
+            }
+        }
+    }
+    return true;
+}
+
+BrowseMenu externalBrowseMenu(bool includeFolder) {
+    BrowseMenu menu;
+    QStringList labels{QStringLiteral("ARTIST"),
+            QStringLiteral("ALBUM"),
+            QStringLiteral("TRACK"),
+            QStringLiteral("KEY"),
+            QStringLiteral("PLAYLIST"),
+            QStringLiteral("MATCHING"),
+            QStringLiteral("GENRE"),
+            QStringLiteral("BPM"),
+            QStringLiteral("RATING")};
+    if (includeFolder) {
+        labels.append(QStringLiteral("FOLDER"));
+    }
+    quint16 position = 0;
+    for (const auto& label : labels) {
+        BrowseCategory category;
+        category.id = static_cast<quint16>(position + 1);
+        category.label = label;
+        category.position = position++;
+        category.visibility = 1;
+        menu.categories.append(category);
+    }
+    return menu;
+}
+
+} // namespace
+
+QString traktorMusicalKeyText(int value) {
+    static const QStringList keys{QStringLiteral("C"),
+            QStringLiteral("C#"),
+            QStringLiteral("D"),
+            QStringLiteral("Eb"),
+            QStringLiteral("E"),
+            QStringLiteral("F"),
+            QStringLiteral("F#"),
+            QStringLiteral("G"),
+            QStringLiteral("Ab"),
+            QStringLiteral("A"),
+            QStringLiteral("Bb"),
+            QStringLiteral("B"),
+            QStringLiteral("Cm"),
+            QStringLiteral("C#m"),
+            QStringLiteral("Dm"),
+            QStringLiteral("Ebm"),
+            QStringLiteral("Em"),
+            QStringLiteral("Fm"),
+            QStringLiteral("F#m"),
+            QStringLiteral("Gm"),
+            QStringLiteral("G#m"),
+            QStringLiteral("Am"),
+            QStringLiteral("Bbm"),
+            QStringLiteral("Bm")};
+    return value >= 0 && value < keys.size() ? keys.at(value) : QString();
+}
+
+ExternalCatalogKind detectExternalCatalog(const QString& path) {
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly) || file.size() > kMaxCatalogBytes) {
+        return ExternalCatalogKind::Unknown;
+    }
+    const QString head = QString::fromUtf8(file.read(4096));
+    if (head.contains(QStringLiteral("<NML"))) {
+        return ExternalCatalogKind::TraktorNml;
+    }
+    if (head.contains(QStringLiteral("<DJ_PLAYLISTS"))) {
+        return ExternalCatalogKind::RekordboxXml;
+    }
+    return ExternalCatalogKind::Unknown;
+}
+
+QStringList findExternalCatalogFiles(const QString& root, int maxDepth, int maxEntries, int maxFiles) {
+    QStringList found;
+    const QString canonicalRoot = QFileInfo(root).canonicalFilePath();
+    if (canonicalRoot.isEmpty()) {
+        return found;
+    }
+    QList<QPair<QString, int>> pending{{canonicalRoot, 0}};
+    int visited = 0;
+    while (!pending.isEmpty() && found.size() < maxFiles) {
+        const auto [directory, depth] = pending.takeFirst();
+        QDirIterator entries(directory,
+                QDir::Dirs | QDir::Files | QDir::NoDotAndDotDot | QDir::Readable);
+        while (entries.hasNext()) {
+            entries.next();
+            if (++visited > maxEntries) {
+                return found;
+            }
+            const QFileInfo entry = entries.fileInfo();
+            if (entry.isSymLink() || isSkippedSystemName(entry.fileName())) {
+                continue;
+            }
+            if (entry.isDir()) {
+                if (depth + 1 <= maxDepth) {
+                    pending.append({entry.absoluteFilePath(), depth + 1});
+                }
+                continue;
+            }
+            const auto suffix = entry.suffix().toLower();
+            if ((suffix == QStringLiteral("nml") || suffix == QStringLiteral("xml")) &&
+                    entry.size() <= kMaxCatalogBytes &&
+                    detectExternalCatalog(entry.absoluteFilePath()) != ExternalCatalogKind::Unknown) {
+                found.append(entry.absoluteFilePath());
+                if (found.size() >= maxFiles) {
+                    break;
+                }
+            }
+        }
+    }
+    found.sort();
+    return found;
+}
+
+QString findLocalTraktorCollection(const QString& documentsPath) {
+    const QDir nativeInstruments(QDir(documentsPath).filePath(QStringLiteral("Native Instruments")));
+    QVersionNumber best(-1);
+    QString bestPath;
+    const auto folders = nativeInstruments.entryInfoList(
+            QDir::Dirs | QDir::NoDotAndDotDot | QDir::NoSymLinks);
+    for (const auto& folder : folders) {
+        const auto name = folder.fileName();
+        if (!name.startsWith(QStringLiteral("Traktor"))) {
+            continue;
+        }
+        const QString collection = QDir(folder.absoluteFilePath()).filePath(QStringLiteral("collection.nml"));
+        if (!QFileInfo::exists(collection)) {
+            continue;
+        }
+        auto version = QVersionNumber::fromString(name.mid(7).trimmed());
+        if (version.isNull()) {
+            version = QVersionNumber(1);
+        }
+        if (bestPath.isEmpty() || version > best) {
+            best = version;
+            bestPath = collection;
+        }
+    }
+    return bestPath;
+}
+
+QByteArray externalCatalogFingerprint(const QStringList& files) {
+    QStringList sorted = files;
+    sorted.sort();
+    QCryptographicHash hash(QCryptographicHash::Sha256);
+    for (const auto& path : std::as_const(sorted)) {
+        const QFileInfo info(path);
+        hash.addData(QStringLiteral("%1|%2|%3\n")
+                             .arg(info.absoluteFilePath())
+                             .arg(info.size())
+                             .arg(info.lastModified().toMSecsSinceEpoch())
+                             .toUtf8());
+    }
+    return hash.result();
+}
+
+std::shared_ptr<RuntimeCatalog> buildExternalCatalog(const QStringList& files,
+        const ExternalCatalogOptions& options,
+        QString* error) {
+    auto catalog = std::make_shared<RuntimeCatalog>();
+    QStringList errors;
+    quint32 nextTrackId = 1;
+    quint32 nextPlaylistId = 1;
+    QHash<QString, quint32> byResolvedPath;
+    int parsedFiles = 0;
+    for (const auto& path : files) {
+        const auto kind = detectExternalCatalog(path);
+        if (kind == ExternalCatalogKind::Unknown) {
+            errors.append(QStringLiteral("%1: not a Traktor or rekordbox XML library")
+                                  .arg(QFileInfo(path).fileName()));
+            continue;
+        }
+        auto parsed = parseFile(path, kind, options);
+        if (!parsed.error.isEmpty()) {
+            errors.append(QStringLiteral("%1: %2").arg(QFileInfo(path).fileName(), parsed.error));
+            if (parsed.tracks.isEmpty()) {
+                continue;
+            }
+        }
+        ++parsedFiles;
+        QHash<QString, quint32> keyToId;
+        for (auto& entry : parsed.tracks) {
+            quint32 id = 0;
+            if (!entry.track.resolvedAudioPath.isEmpty()) {
+                id = byResolvedPath.value(entry.track.resolvedAudioPath);
+            }
+            if (id == 0) {
+                if (nextTrackId > static_cast<quint32>(kMaxTracks)) {
+                    errors.append(QStringLiteral("Too many tracks"));
+                    break;
+                }
+                id = nextTrackId++;
+                entry.track.rekordboxId = id;
+                // Unique catalog key: the absolute audio path, or a provider key.
+                entry.track.audioRelativePath = !entry.track.resolvedAudioPath.isEmpty()
+                        ? entry.track.resolvedAudioPath
+                        : QStringLiteral("missing:%1:%2").arg(id).arg(
+                                  entry.lookupKeys.value(0));
+                entry.track.analysisState = RuntimeAnalysisState::Missing;
+                entry.track.rawMetadata.insert(QStringLiteral("source_file"),
+                        QFileInfo(path).fileName());
+                if (!entry.track.resolvedAudioPath.isEmpty()) {
+                    byResolvedPath.insert(entry.track.resolvedAudioPath, id);
+                }
+                if (!catalog->insertTrack(entry.track)) {
+                    continue;
+                }
+            }
+            for (const auto& key : std::as_const(entry.lookupKeys)) {
+                if (!key.isEmpty() && !keyToId.contains(key)) {
+                    keyToId.insert(key, id);
+                }
+            }
+        }
+        for (const auto& root : std::as_const(parsed.roots)) {
+            RuntimePlaylistNode node;
+            convertNode(root, keyToId, &nextPlaylistId, &node);
+            if (!catalog->insertPlaylist(std::move(node))) {
+                errors.append(QStringLiteral("%1: invalid playlist %2")
+                                      .arg(QFileInfo(path).fileName(), root.name));
+            }
+        }
+    }
+    for (const auto& message : std::as_const(errors)) {
+        catalog->appendDiagnostic(message);
+    }
+    if (parsedFiles == 0) {
+        if (error) {
+            *error = errors.isEmpty() ? QStringLiteral("No library file could be read")
+                                      : errors.join(QStringLiteral("; "));
+        }
+        catalog->invalidate();
+        return nullptr;
+    }
+    catalog->setBrowseMenu(externalBrowseMenu(options.includeFolderCategory));
+    catalog->seal();
+    if (error) {
+        *error = errors.join(QStringLiteral("; "));
+    }
+    return catalog;
+}
+
+} // namespace mixxx::rekordbox
