+#include <gtest/gtest.h>
+
+#include <QCryptographicHash>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QTemporaryDir>
+
+#include "library/rekordbox/rekordboxdevice.h"
+#include "library/rekordbox/rekordboxusbsession.h"
+#include "track/track.h"
+#include "track/trackusepolicy.h"
+
+namespace {
+using namespace mixxx::rekordbox;
+
+QString write(const QString& path, const QByteArray& bytes) {
+    EXPECT_TRUE(QDir().mkpath(QFileInfo(path).absolutePath()));
+    QFile file(path);
+    EXPECT_TRUE(file.open(QIODevice::WriteOnly));
+    EXPECT_EQ(file.write(bytes), bytes.size());
+    return path;
+}
+
+QByteArray digest(const QString& path) {
+    QFile file(path);
+    EXPECT_TRUE(file.open(QIODevice::ReadOnly));
+    return QCryptographicHash::hash(file.readAll(), QCryptographicHash::Sha256);
+}
+} // namespace
+
+TEST(Rx3ExternalTrackTest, TraktorLibraryProjectsReadOnlyTemporaryTracks) {
+    QTemporaryDir usb;
+    ASSERT_TRUE(usb.isValid());
+    const QString root = QFileInfo(usb.path()).canonicalFilePath();
+    const auto audio = write(QDir(root).filePath("Traktor Export/song.mp3"), QByteArray(4096, '\0'));
+    const auto nml = write(QDir(root).filePath("Traktor Export/Set.nml"),
+            R"(<?xml version="1.0" encoding="UTF-8"?>
+<NML VERSION="19"><COLLECTION ENTRIES="1">
+<ENTRY TITLE="Song" ARTIST="Someone"><LOCATION DIR="/:Traktor Export/:" FILE="song.mp3" VOLUME="USB"></LOCATION>
+<INFO KEY="Am" RANKING="204"></INFO><TEMPO BPM="128.0"></TEMPO>
+<CUE_V2 NAME="AutoGrid" TYPE="4" START="12.5" LEN="0" HOTCUE="-1"></CUE_V2>
+<CUE_V2 NAME="Drop" TYPE="0" START="30000" LEN="0" HOTCUE="0"></CUE_V2>
+</ENTRY></COLLECTION><PLAYLISTS><NODE TYPE="FOLDER" NAME="$ROOT"><SUBNODES COUNT="1">
+<NODE TYPE="PLAYLIST" NAME="Set"><PLAYLIST ENTRIES="1" TYPE="LIST">
+<ENTRY><PRIMARYKEY TYPE="TRACK" KEY="USB/:Traktor Export/:song.mp3"></PRIMARYKEY></ENTRY>
+</PLAYLIST></NODE></SUBNODES></NODE></PLAYLISTS></NML>)");
+    const auto audioBefore = digest(audio);
+    const auto nmlBefore = digest(nml);
+
+    ExternalSessionSource source;
+    source.files = {nml};
+    source.volumeRoot = root;
+    source.kind = QStringLiteral("usb");
+    source.includeFolderCategory = true;
+    RekordboxUsbSession session(root, source);
+    ASSERT_TRUE(session.isExternal());
+    ASSERT_TRUE(session.load()) << session.error().toStdString();
+    ASSERT_EQ(UsbSessionState::Ready, session.state());
+    const auto catalog = session.catalog();
+    ASSERT_TRUE(catalog);
+    ASSERT_EQ(1, catalog->tracks().size());
+    const auto id = catalog->tracks().keys().first();
+    EXPECT_EQ(QStringLiteral("usb"), session.deviceSnapshot().externalKind);
+
+    QString error;
+    const auto track = session.createTemporaryTrack(id, &error);
+    ASSERT_TRUE(track) << error.toStdString();
+    EXPECT_EQ(mixxx::TrackUsePolicy::usbFolderPolicy(), track->getUsePolicy());
+    EXPECT_FALSE(track->getUsePolicy().canPersist());
+    EXPECT_FALSE(track->getUsePolicy().canExportMetadata());
+    EXPECT_TRUE(track->getUsePolicy().canAnalyze());
+    EXPECT_EQ(mixxx::SourceType::StandardLibrary, track->getSourceBinding().sourceType());
+    EXPECT_TRUE(track->isSourceAvailableForPlayback());
+    EXPECT_EQ(QStringLiteral("Song"), track->getTitle());
+    EXPECT_EQ(QStringLiteral("Someone"), track->getArtist());
+    EXPECT_EQ(4, track->getRating());
+    EXPECT_EQ(QStringLiteral("traktor"), track->property("externalLibraryProvider").toString());
+    EXPECT_FALSE(track->property("rekordboxTimingSemantics").toBool());
+
+    // Every write path refuses this source.
+    EXPECT_EQ(QStringLiteral("This library is read-only in NauticMixxx."),
+            session.writeRating(id, 5));
+    EXPECT_EQ(QStringLiteral("This library is read-only in NauticMixxx."),
+            session.writeList(QStringLiteral("x"), {id}, false));
+    EXPECT_TRUE(isReadOnlySourcePath(audio));
+    EXPECT_TRUE(isReadOnlyPath(audio));
+    EXPECT_TRUE(session.refresh());
+    EXPECT_EQ(audioBefore, digest(audio));
+    EXPECT_EQ(nmlBefore, digest(nml));
+
+    session.invalidate();
+    EXPECT_FALSE(session.createTemporaryTrack(id));
+}
+
+TEST(Rx3ExternalTrackTest, MissingAudioIsNotLoadable) {
+    QTemporaryDir directory;
+    ASSERT_TRUE(directory.isValid());
+    const auto xml = write(directory.filePath("rekordbox.xml"), R"(<?xml version="1.0"?>
+<DJ_PLAYLISTS Version="1.0.0"><COLLECTION Entries="1">
+<TRACK TrackID="1" Name="Ghost" Location="file://localhost/nonexistent/ghost.mp3"/>
+</COLLECTION><PLAYLISTS><NODE Type="0" Name="ROOT" Count="0"></NODE></PLAYLISTS></DJ_PLAYLISTS>)");
+    ExternalSessionSource source;
+    source.files = {xml};
+    source.kind = QStringLiteral("library");
+    RekordboxUsbSession session(xml, source);
+    ASSERT_TRUE(session.load()) << session.error().toStdString();
+    const auto id = session.catalog()->tracks().keys().first();
+    QString error;
+    EXPECT_FALSE(session.createTemporaryTrack(id, &error));
+    EXPECT_FALSE(error.isEmpty());
+}
