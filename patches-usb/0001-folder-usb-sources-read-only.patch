+namespace mixxx::rekordbox {
+
+// Read-only DJ library files that NauticMixxx can browse besides rekordbox USB
+// exports. Parsing never writes to the file, its folder or the audio files.
+enum class ExternalCatalogKind {
+    Unknown,
+    TraktorNml,   // Traktor collection.nml or an exported Traktor playlist (.nml)
+    RekordboxXml, // rekordbox "Export Collection in xml format" (DJ_PLAYLISTS)
+};
